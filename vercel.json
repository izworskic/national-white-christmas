{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/national-white-christmas.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/national-tools/white-christmas/forecast",
      "destination": "/national-tools/white-christmas/forecast/index.html"
    },
    {
      "source": "/national-tools/white-christmas/forecast/",
      "destination": "/national-tools/white-christmas/forecast/index.html"
    },
    {
      "source": "/national-tools/white-christmas/regions",
      "destination": "/national-tools/white-christmas/regions/index.html"
    },
    {
      "source": "/national-tools/white-christmas/regions/",
      "destination": "/national-tools/white-christmas/regions/index.html"
    },
    {
      "source": "/national-tools/white-christmas/regions/:slug",
      "destination": "/national-tools/white-christmas/regions/:slug/index.html"
    },
    {
      "source": "/national-tools/white-christmas/regions/:slug/",
      "destination": "/national-tools/white-christmas/regions/:slug/index.html"
    },
    {
      "source": "/national-tools/white-christmas/cities",
      "destination": "/national-tools/white-christmas/cities/index.html"
    },
    {
      "source": "/national-tools/white-christmas/cities/",
      "destination": "/national-tools/white-christmas/cities/index.html"
    },
    {
      "source": "/national-tools/white-christmas/cities/:slug",
      "destination": "/national-tools/white-christmas/cities/:slug/index.html"
    },
    {
      "source": "/national-tools/white-christmas/cities/:slug/",
      "destination": "/national-tools/white-christmas/cities/:slug/index.html"
    }
  ]
}
